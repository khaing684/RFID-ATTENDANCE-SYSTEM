generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ACADEMIC YEAR - ပညာသင်နှစ် (2025-2026)
// ============================================
model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique // "2025-2026"
  isCurrent Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enrollments Enrollment[]

  @@map("academic_years")
}

// ============================================
// GRADE LEVEL - အတန်း (Grade-10, Grade-11)
// ============================================
model GradeLevel {
  id        String    @id @default(uuid())
  name      String    // "Grade-10"
  level     Int       @default(0) // 10, 11, 12
  sections  Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
  @@map("grade_levels")
}

// ============================================
// SECTION - အခန်း (Section-A, Section-B)
// ============================================
model Section {
  id           String   @id @default(uuid())
  name         String   // "Section-A"
  gradeLevelId String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  teacherId    String?  // အတန်းပိုင်ဆရာ
  teacher      User?    @relation("SectionTeacher", fields: [teacherId], references: [id])
  room         String?  // စာသင်ခန်း (Rm-201)
  capacity     Int      @default(40) // ကျောင်းသားဦးရေကန့်သတ်ချက်
  schedules    Schedule[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, gradeLevelId])
  @@map("sections")
}

// ============================================
// USER - စနစ်အသုံးပြုသူများ
// ============================================
model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(STUDENT)
  phone       String?
  avatar      String?
  isActive    Boolean  @default(true)
  
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacherSections    Section[]  @relation("SectionTeacher")
  enrollments        Enrollment[]
  assignedTags  Tag[]     @relation("AssignedTo")
  scanLogs      ScanLog[]
  createdTags   Tag[]     @relation("CreatedBy")
  createdDevices Device[] @relation("DeviceCreatedBy")

  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// ============================================
// ENROLLMENT - ကျောင်းသားစာရင်း (Student → Section)
// ============================================
model Enrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  enrolledAt     DateTime     @default(now())

  @@unique([studentId, sectionId, academicYearId])
  @@index([sectionId])
  @@index([academicYearId])
  @@map("enrollments")
}

// ============================================
// SUBJECT - ဘာသာရပ် (မြန်မာ, အင်္ဂလိပ်, သင်္ချာ)
// ============================================
model Subject {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  color     String     @default("#1677ff")
  credits   Int        @default(1)  // ဘာသာရပ်ခရက်ဒစ်
  teacherId String?    // တာဝန်ခံဆရာ
  teacher   User?      @relation("SubjectTeacher", fields: [teacherId], references: [id])
  schedules Schedule[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("subjects")
}

// ============================================
// SCHEDULE - အချိန်ဇယား (Timetable)
// ============================================
model Schedule {
  id        String   @id @default(uuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  dayOfWeek Int      // 0=Sun, 1=Mon ... 6=Sat
  startTime String   // "08:00"
  endTime   String   // "08:45"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, dayOfWeek, startTime])
  @@index([sectionId, dayOfWeek])
  @@map("schedules")
}


// ============================================
// TAG - RFID Tag များ (ကျောင်းသား/ဆရာ ကတ်ပြား)
// ============================================
model Tag {
  id          String    @id @default(uuid())
  rfidCode    String    @unique
  tagType     TagType   @default(PASSIVE)
  status      TagStatus @default(ACTIVE)
  description String?

  // ဘယ်သူ့ဆီမှာ ရှိလဲ (Teacher သို့ Student)
  assignedToId String?
  assignedTo   User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Tracking
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scanLogs ScanLog[]

  @@index([status])
  @@index([rfidCode])
  @@map("tags")
}

enum TagType {
  PASSIVE
  ACTIVE
}

enum TagStatus {
  ACTIVE
  INACTIVE
  LOST
  DAMAGED
}

// ============================================
// DEVICE - RFID Reader စက်များ
// ============================================
model Device {
  id              String       @id @default(uuid())
  name            String
  deviceCode      String       @unique
  deviceType      DeviceType   @default(HANDHELD)
  location        String?
  ipAddress       String?
  status          DeviceStatus @default(OFFLINE)
  firmwareVersion String?

  lastSeenAt DateTime?

  createdById String
  createdBy   User         @relation("DeviceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scanLogs ScanLog[]

  @@index([status])
  @@map("devices")
}

enum DeviceType {
  HANDHELD
  FIXED
  USB
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

// ============================================
// SCAN LOG - တက်ရောက်မှု မှတ်တမ်း
// ============================================
model ScanLog {
  id       String   @id @default(uuid())

  tagId    String
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])

  scanType  ScanType @default(CHECK_IN)
  scannedAt DateTime @default(now())
  notes     String?

  @@index([tagId])
  @@index([deviceId])
  @@index([scannedAt])
  @@index([scanType])
  @@map("scan_logs")
}

enum ScanType {
  CHECK_IN
  CHECK_OUT
  INVENTORY
  LOCATE
}

// ============================================
// HOLIDAY - အားလပ်ရက်ပြက္ခဒိန်
// ============================================
model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique       // 2026-01-04 (ရက်စွဲ)
  name        String                 // "အာဇာနည်နေ့"
  type        String   @default("NATIONAL") // NATIONAL | SCHOOL | EXAM
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
  @@map("holidays")
}

// ============================================
// SETTING - စနစ် သတ်မှတ်ချက်များ (key-value)
// ============================================
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}