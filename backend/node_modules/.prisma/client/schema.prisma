generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// GRADE - အတန်း (Grade-10, Grade-9)
// ============================================
model Grade {
  id        String   @id @default(uuid())
  name      String // "Grade-10"
  type      String   @default("PHYSICAL") // ONLINE | PHYSICAL
  level     Int      @default(0) // sorting အတွက် (9, 10, 11)
  classes   Class[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type]) // "Grade-10" + "ONLINE" = unique
  @@map("grades")
}

// ============================================
// CLASS - အခန်း (Section-A, Section-B)
// ============================================
model Class {
  id         String      @id @default(uuid())
  name       String // "Section-A"
  gradeId    String
  grade      Grade       @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  teacherId  String? // အတန်းပိုင်ဆရာ (User ID)
  teacher    User?       @relation("ClassTeacher", fields: [teacherId], references: [id])
  students   User[]      @relation("StudentClass")
  timetables Timetable[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([name, gradeId])
  @@map("classes")
}

// ============================================
// USER - စနစ်အသုံးပြုသူများ
// ============================================
model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  role     Role    @default(STUDENT)
  phone    String?
  avatar   String?
  isActive Boolean @default(true)
  classId  String?
  class    Class?  @relation("StudentClass", fields: [classId], references: [id])

  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  teacherClasses Class[]   @relation("ClassTeacher")
  assignedTags   Tag[]     @relation("AssignedTo")
  scanLogs       ScanLog[]
  createdTags    Tag[]     @relation("CreatedBy")
  createdDevices Device[]  @relation("DeviceCreatedBy")

  @@index([classId])
  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

// ============================================
// SUBJECT - ဘာသာရပ် (မြန်မာ, အင်္ဂလိပ်, သင်္ချာ)
// ============================================
model Subject {
  id         String      @id @default(uuid())
  name       String
  code       String      @unique
  color      String      @default("#1677ff")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  timetables Timetable[]

  @@map("subjects")
}

// ============================================
// TIMETABLE - အချိန်ဇယား
// ============================================
model Timetable {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  dayOfWeek Int // 0=Sun, 1=Mon ... 6=Sat
  startTime String // "08:00"
  endTime   String // "08:45"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, dayOfWeek, startTime])
  @@index([classId, dayOfWeek])
  @@map("timetables")
}

// ============================================
// TAG - RFID Tag များ (ကျောင်းသား/ဆရာ ကတ်ပြား)
// ============================================
model Tag {
  id          String    @id @default(uuid())
  rfidCode    String    @unique
  tagType     TagType   @default(PASSIVE)
  status      TagStatus @default(ACTIVE)
  description String?

  // ဘယ်သူ့ဆီမှာ ရှိလဲ (Teacher သို့ Student)
  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Tracking
  createdById String
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scanLogs ScanLog[]

  @@index([status])
  @@index([rfidCode])
  @@map("tags")
}

enum TagType {
  PASSIVE
  ACTIVE
}

enum TagStatus {
  ACTIVE
  INACTIVE
  LOST
  DAMAGED
}

// ============================================
// DEVICE - RFID Reader စက်များ
// ============================================
model Device {
  id              String       @id @default(uuid())
  name            String
  deviceCode      String       @unique
  deviceType      DeviceType   @default(HANDHELD)
  location        String?
  ipAddress       String?
  status          DeviceStatus @default(OFFLINE)
  firmwareVersion String?

  lastSeenAt DateTime?

  createdById String
  createdBy   User     @relation("DeviceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scanLogs ScanLog[]

  @@index([status])
  @@map("devices")
}

enum DeviceType {
  HANDHELD
  FIXED
  USB
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

// ============================================
// SCAN LOG - တက်ရောက်မှု မှတ်တမ်း
// ============================================
model ScanLog {
  id String @id @default(uuid())

  tagId    String
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  scanType  ScanType @default(CHECK_IN)
  scannedAt DateTime @default(now())
  notes     String?

  @@index([tagId])
  @@index([deviceId])
  @@index([scannedAt])
  @@index([scanType])
  @@map("scan_logs")
}

enum ScanType {
  CHECK_IN
  CHECK_OUT
  INVENTORY
  LOCATE
}

// ============================================
// SETTING - စနစ် သတ်မှတ်ချက်များ (key-value)
// ============================================
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
